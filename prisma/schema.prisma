// Prisma schema for GATE Test Series Platform
// Configured for PostgreSQL (compatible with Neon, Supabase, Vercel Postgres)
// Uses DATABASE_URL (pooled) and DIRECT_URL (direct)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String         @id @default(cuid())
  googleId    String         @unique
  email       String         @unique
  name        String
  avatarUrl   String?
  role        String         @default("STUDENT") // "STUDENT" | "TEACHER" | "ADMIN"
  targetExam  String?        // "GATE" | "JEE_MAINS" (null for new users until onboarding modal)
  createdAt   DateTime       @default(now())
  isSubscribed      Boolean         @default(false)
  subscriptionTier  String?         // "GATE_FULL_PASS" | "PREMIUM"
  subscriptionUntil DateTime?
  payments          PaymentRecord[]
  reportCards ReportCard[]
  mistakes    MistakeEntry[]
  bookmarks   Bookmark[]
  publishedTests PublishedTest[]
}

model PaymentRecord {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String    // e.g. "gate-full-pass"
  planName        String    // "GATE Complete Mock Test Series"
  amount          Float     // e.g. 499.00
  utrNumber       String    @unique // 12-digit Indian Bank UTR
  upiIdUsed       String?
  status          String    @default("PENDING") // "VERIFIED" | "PENDING" | "REJECTED"
  adminNote       String?
  createdAt       DateTime  @default(now())
  verifiedAt      DateTime?

  @@index([userId])
  @@index([utrNumber])
  @@index([status])
}

model ReportCard {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testTitle          String
  examCategory       String   @default("GATE") // "GATE" | "JEE_MAINS"
  mode               String   // "EXAM" | "PRACTICE"
  totalQuestions     Int
  maxMarks           Float
  score              Float
  accuracy           Float
  correctCount       Int
  incorrectCount     Int
  unattemptedCount   Int
  positiveMarks      Float
  negativeMarks      Float
  timeTakenSeconds   Int
  allocatedSeconds   Int
  breakdownJson      Json
  detailedReviewJson Json
  submittedAt        DateTime @default(now())

  @@index([userId])
  @@index([submittedAt])
  @@index([examCategory])
}

model MistakeEntry {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionHash         String
  questionSnapshotJson Json
  subject              String
  topic                String
  wrongCount           Int       @default(1)
  status               String    @default("NEEDS_REVIEW") // "NEEDS_REVIEW" | "MASTERED"
  lastWrongAt          DateTime  @default(now())
  masteredAt           DateTime?

  @@unique([userId, questionHash])
  @@index([userId])
  @@index([status])
  @@index([subject])
}

model Bookmark {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionHash         String
  questionSnapshotJson Json
  subject              String
  topic                String
  note                 String?
  createdAt            DateTime @default(now())

  @@unique([userId, questionHash])
  @@index([userId])
  @@index([subject])
}

model Subject {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  examCategory String     @default("GATE") // "GATE" | "JEE_MAINS"
  createdAt    DateTime   @default(now())
  topics       Topic[]
  questions    Question[]

  @@index([examCategory])
}

model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  subjectId Int
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  questions Question[]

  @@unique([subjectId, name])
}

model Question {
  id              Int      @id @default(autoincrement())
  contentHash     String   @unique
  subjectId       Int
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topicId         Int
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  type            String   // "MCQ" | "MSQ" | "NAT"
  marks           Int      // 1 | 2
  questionText    String
  optionsJson     String?  // JSON stringified array of string options
  answerJson      String   // JSON stringified answer (number | number[] | {min, max})
  solution        String
  imageUrl        String?
  solutionImageUrl String?
  sourceTestTitle String?
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([subjectId])
  @@index([topicId])
  @@index([type])
  @@index([marks])
  @@index([isArchived])
}

model PublishedTest {
  id              String   @id @default(cuid())
  title           String
  description     String?
  category        String   @default("FULL_MOCK") // "FULL_MOCK" | "SUBJECT_PACK" | "CHAPTER_TEST" | "PERSONAL"
  examCategory    String   @default("GATE")      // "GATE" | "JEE_MAINS"
  subject         String?
  totalQuestions  Int
  totalMarks      Float
  durationMinutes Int
  questionsJson   String   // Stored test data payload (questions, options, answers, etc.)
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorRole     String   @default("STUDENT") // "STUDENT" | "TEACHER" | "ADMIN"
  isOfficial      Boolean  @default(false)     // true = Teacher/Admin Test Series; false = Student Personal Test
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([creatorId])
  @@index([isOfficial])
  @@index([category])
  @@index([examCategory])
}

