// Prisma schema for GATE Test Series Platform
// Configured for PostgreSQL (compatible with Neon, Supabase, Vercel Postgres)
// Uses DATABASE_URL (pooled) and DIRECT_URL (direct)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id @default(cuid())
  googleId    String       @unique
  email       String       @unique
  name        String
  avatarUrl   String?
  createdAt   DateTime     @default(now())
  reportCards ReportCard[]
}

model ReportCard {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testTitle          String
  mode               String   // "EXAM" | "PRACTICE"
  totalQuestions     Int
  maxMarks           Float
  score              Float
  accuracy           Float
  correctCount       Int
  incorrectCount     Int
  unattemptedCount   Int
  positiveMarks      Float
  negativeMarks      Float
  timeTakenSeconds   Int
  allocatedSeconds   Int
  breakdownJson      Json
  detailedReviewJson Json
  submittedAt        DateTime @default(now())

  @@index([userId])
  @@index([submittedAt])
}

model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  topics    Topic[]
  questions Question[]
}

model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  subjectId Int
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  questions Question[]

  @@unique([subjectId, name])
}

model Question {
  id              Int      @id @default(autoincrement())
  contentHash     String   @unique
  subjectId       Int
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topicId         Int
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  type            String   // "MCQ" | "MSQ" | "NAT"
  marks           Int      // 1 | 2
  questionText    String
  optionsJson     String?  // JSON stringified array of string options
  answerJson      String   // JSON stringified answer (number | number[] | {min, max})
  solution        String
  imageUrl        String?
  tikzCode        String?
  solutionImageUrl String?
  solutionTikzCode String?
  sourceTestTitle String?
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([subjectId])
  @@index([topicId])
  @@index([type])
  @@index([marks])
  @@index([isArchived])
}
