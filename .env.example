# ─────────────────────────────────────────────────────────────
# Abhiyantra GATE Test Series Platform Environment Config
# ─────────────────────────────────────────────────────────────

# PostgreSQL Database (Neon, Supabase, or Vercel Postgres)
# Pooled connection string for queries
DATABASE_URL="postgresql://username:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://username:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Backend Client ID
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# Frontend Client ID for Vite (must match GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# JWT Secret for signing student session cookies
JWT_SECRET="your-secure-random-jwt-secret-key-at-least-32-chars"

# Application URL
APP_URL="https://abhiyantra-test-series.vercel.app"

# Local Server Port (optional, default 3001)
PORT=3001
